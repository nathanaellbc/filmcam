# Brainstorming visual companion — session servers, screens, and state
.superpowers/

# macOS
.DS_Store

# Xcode (for when the Swift work starts)
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Stage W reference implementation (Rust / Python)
target/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Captured media and generated test assets — large, regenerable
*.fcr
*.fcm
*.dng
*.mcraw
/testdata/generated/

# ...except the conformance vectors, which ARE the deliverable. The Swift
# port validates against these exact bytes, so they must be committed.
!/tools/fcr-reference/vectors/*.fcr
!/tools/fcr-reference/vectors/*.fcm

# Sample footage shot on-device for measurement — large, not repo content.
# Keep the reference tool's own committed vectors (negated above) intact.
/tools/fcr-reference/sample/
/tools/fcr-reference/*_dng/
*.wav
